{
  "$defs": {
    "CoverageStatus": {
      "enum": [
        "COVERED",
        "PARTIAL",
        "MISSING",
        "UNKNOWN"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "DefaultPolicyRule": {
      "additionalProperties": false,
      "properties": {
        "allowedStatuses": {
          "items": {
            "$ref": "#/$defs/CoverageStatus"
          },
          "minItems": 1,
          "title": "Allowedstatuses",
          "type": "array"
        }
      },
      "required": [
        "allowedStatuses"
      ],
      "title": "DefaultPolicyRule",
      "type": "object"
    },
    "EvidenceMetadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "EvidenceMetadata",
      "type": "object"
    },
    "PolicyRules": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/DefaultPolicyRule"
        }
      },
      "required": [
        "default"
      ],
      "title": "PolicyRules",
      "type": "object"
    },
    "PolicyWaiver": {
      "additionalProperties": false,
      "properties": {
        "obligationRef": {
          "minLength": 1,
          "title": "Obligationref",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "approvedBy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approvedby"
        }
      },
      "required": [
        "obligationRef",
        "reason",
        "expiresAt"
      ],
      "title": "PolicyWaiver",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "qcov.dev/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "QualityPolicy",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/EvidenceMetadata"
    },
    "rules": {
      "$ref": "#/$defs/PolicyRules"
    },
    "waivers": {
      "items": {
        "$ref": "#/$defs/PolicyWaiver"
      },
      "title": "Waivers",
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "rules"
  ],
  "title": "QualityPolicy",
  "type": "object"
}
